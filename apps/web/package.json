{
  "name": "@sonafrik/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:clean": "node ./scripts/clean-next.mjs && next dev -p 3000",
    "build": "next build",
    "analyze": "cross-env ANALYZE=true next build",
    "start": "next start",
    "start:prod": "next start -p 3001",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:smoke": "playwright test smoke"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.58.0",
    "@sonafrik/api": "workspace:*",
