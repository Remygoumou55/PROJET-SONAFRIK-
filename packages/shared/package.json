{
  "name": "@sonafrik/shared",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./payment": {
      "types": "./dist/payment/index.d.ts",
      "default": "./dist/payment/index.js"
    },
    "./field-limits": {
      "types": "./dist/fieldLimits.d.ts",
      "default": "./dist/fieldLimits.js"
    },
    "./performance": {
      "types": "./dist/performance/index.d.ts",
      "default": "./dist/performance/index.js"
    },
    "./auth": {
      "types": "./dist/auth/devBypass.d.ts",
      "default": "./dist/auth/devBypass.js"
    },
    "./audio": {
      "types": "./dist/audio/audio-integrity.d.ts",
      "default": "./dist/audio/audio-integrity.js"
    },
    "./streaming": {
      "types": "./dist/streaming/buildStreamCompletePayload.d.ts",
      "default": "./dist/streaming/buildStreamCompletePayload.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sonafrik/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.19.20",
    "eslint": "^9.28.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.6"
  }
}
