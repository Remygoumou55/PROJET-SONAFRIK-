{
  "name": "@sonafrik/metadata",
  "version": "0.2.1",
  "private": true,
  "description": "SONAFRIK Metadata Engine — ISRC Engine Hardened (Phase 2.5)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "default": "./dist/errors/index.js"
    },
    "./isrc": {
      "types": "./dist/isrc/index.d.ts",
      "default": "./dist/isrc/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@sonafrik/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.28.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
