# Supabase — Web
# Copier .env.example → apps/web/.env.local et remplir avec vos vraies valeurs.
# Récupérer ces valeurs dans : Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<votre-anon-key>
# ⚠️ NE JAMAIS COMMITTER — réservé aux Server Actions et Route Handlers
SUPABASE_SERVICE_ROLE_KEY=<votre-service-role-key>

# Dev local uniquement — court-circuite middleware et guards (JAMAIS sur Vercel/prod)
# Mettre false pour tester auth réelle, redirects et guards admin
BYPASS_AUTH=true
NEXT_PUBLIC_BYPASS_AUTH=true
NEXT_PUBLIC_LOCAL_AUDIT_MODE=true

# OAuth Google — URL stable de l'app (évite que les preview URLs Vercel soient rejetées)
# En dev local, laisser vide (fallback automatique sur window.location.origin)
# En production, mettre l'URL Vercel stable : https://monapp.vercel.app
NEXT_PUBLIC_APP_URL=

# Supabase — Mobile (Expo)
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<votre-anon-key>

# Redis (Upstash) — Sprint 6+
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Meilisearch — Sprint 5+
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=

# Dev local — activer le portefeuille & paiements (Vague E)
# Mettre true pour tester TopupModal + retraits (sandbox sans credentials opérateurs)
NEXT_PUBLIC_PAYMENTS_ENABLED=false

# URL publique de l'app (callbacks Wave success/error + Edge Functions)
SONAFRIK_WEB_URL=http://localhost:3000

# Paiements mobiles africains — Sprint G-4 / Vague E
# Toutes les clés ci-dessous sont UNIQUEMENT côté serveur (Edge Functions).
# Ne jamais les exposer avec NEXT_PUBLIC_ ni EXPO_PUBLIC_.

# Orange Money Guinée
ORANGE_MONEY_BASE_URL=https://api.orange.com/orange-money-webpay/guinea/v1
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_WEBHOOK_SECRET=
ORANGE_MONEY_GN_SANDBOX=true

# MTN Mobile Money (MoMo) Guinée
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_CALLBACK_API_KEY=
MTN_MOMO_GN_SANDBOX=true

# Wave Guinée
WAVE_BASE_URL=https://api.wave.com/v1
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
WAVE_GN_SANDBOX=true

# Soutra Money
SOUTRA_BASE_URL=https://api.soutra.money/v1
SOUTRA_MERCHANT_ID=
SOUTRA_API_KEY=
SOUTRA_WEBHOOK_SECRET=
SOUTRA_MONEY_SANDBOX=true

# Stripe (international, Sprint futur)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Monitoring — Sprint 13
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=

# Sauvegardes locales (développement uniquement — NE PAS utiliser en production sans accord)
# Récupérer dans : Supabase Dashboard → Settings → Database → Connection string (Transaction pooler)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres
