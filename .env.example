# Supabase — Web
# Copier .env.example → .env.local et remplir avec vos vraies valeurs.
# Récupérer ces valeurs dans : Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<votre-anon-key>
# ⚠️ NE JAMAIS COMMITTER — réservé aux Server Actions et Route Handlers
SUPABASE_SERVICE_ROLE_KEY=<votre-service-role-key>

# Supabase — Mobile (Expo)
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<votre-anon-key>

# Redis (Upstash) — Sprint 6+
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Meilisearch — Sprint 5+
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=

# Payments — Sprint 12
ORANGE_MONEY_API_KEY=
MTN_MOMO_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Monitoring — Sprint 13
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=
